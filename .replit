[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["node", "./dist/index.cjs"]
build = ["npm", "run", "build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "authz"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "資料操作プレビュー"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "authz"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -i PATH=\"$PATH\" LANG=C LC_ALL=C TZ=UTC node --import tsx tests/run-ephemeral-tests.mjs authz"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "資料操作プレビュー"
mode = "parallel"
author = "agent"

[workflows.workflow.metadata]
outputType = "vnc"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -i PATH=\"$PATH\" HOME=\"$HOME\" DISPLAY=:0 node prototypes/evidence-consultation/regional-support-09/launch.mjs --workspace-vnc-confirmed"

[userenv]

[userenv.shared]
LINE_CHANNEL_ID = "2009322288"
LINE_CHANNEL_SECRET = "4ddd01dec848fd331488e872595c98d5"
VITE_LIFF_ID = "2009322288-bQdxwbbv"

[userenv.development]
SUPPORTER_ACCESS_ENABLED = "true"
SUPPORTER_DEV_DATABASE_NAME = "heliumdb"
SUPPORTER_DEV_FIXTURES_ENABLED = "true"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
